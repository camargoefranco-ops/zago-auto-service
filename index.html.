<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zago Auto Service</title>
<script src="https://cloudflare.com"></script>
<script src="https://jsdelivr.net"></script>
<style>
  :root{
    --bg:#0d0d0d;
    --surface:#161616;
    --surface-2:#1e1e1e;
    --gold:#f2c230;
    --gold-deep:#b8891a;
    --white:#f2f2f0;
    --grey:#8a8a86;
    --line:#2c2a22;
    --ok:#3fa34d;
    --wait:#d99a2b;
    --danger:#c94f4f;
  }
  *{box-sizing:border-box; margin: 0; padding: 0;}
  body{
    background:var(--bg);
    color:var(--white);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
    display:flex;
    justify-content:center;
    min-height: 100vh;
  }
  #app{width:100%;max-width:460px;min-height:100vh;background:var(--bg);position:relative;padding-bottom:40px;}

  .brandbar{
    padding:18px 20px 14px;
    text-align:center;
    background:linear-gradient(180deg,#141414,#0d0d0d);
    border-bottom:1px solid var(--line);
  }
  .screen{padding:18px 18px 10px;}
  .hide{display:none !important;}
  h2.title{font-size:19px;margin:2px 0 16px;font-weight:800;letter-spacing:.2px;}
  p.sub{color:var(--grey);font-size:13.5px;line-height:1.5;margin:-8px 0 18px;}

  .bigbtn{
    display:flex;align-items:center;gap:14px;
    width:100%;
    background:var(--surface);
    border:1px solid var(--line);
    color:var(--white);
    padding:16px 16px;
    border-radius:10px;
    margin-bottom:12px;
    font-size:15.5px;
    font-weight:700;
    text-align:left;
    cursor:pointer;
    clip-path:polygon(0 0,100% 0,100% 100%,14px 100%,0 calc(100% - 14px));
    transition:border-color .15s ease, transform .1s ease;
  }
  .bigbtn:active{transform:scale(.98);}
  .bigbtn .ic{
    width:38px;height:38px;flex-shrink:0;
    background:var(--gold);
    border-radius:8px;
    display:flex;align-items:center;justify-content:center;
    color:#0d0d0d;
    font-size:18px;font-weight:900;
  }
  .bigbtn .meta{color:var(--grey);font-weight:500;font-size:12px;margin-top:2px;}

  label{display:block;font-size:12.5px;color:var(--grey);margin:14px 0 6px;font-weight:600;}
  input, select, textarea{
    width:100%;
    background:var(--surface-2);
    border:1px solid var(--line);
    color:var(--white);
    padding:12px 12px;
    border-radius:8px;
    font-size:14.5px;
    font-family:inherit;
    margin-bottom: 10px;
  }
  input:focus, select:focus, textarea:focus{outline:2px solid var(--gold);border-color:var(--gold);}
  
  .btn{
    width:100%;
    background:var(--gold);
    color:#0d0d0d;
    border:none;
    padding:14px;
    border-radius:8px;
    font-size:15px;
    font-weight:800;
    margin-top:12px;
    cursor:pointer;
  }
  .btn.secondary{background:transparent; border:1px solid var(--gold-deep); color:var(--gold);}
  .btn.danger{background:var(--danger); color:white;}

  .wizback{background:none;border:none;color:var(--gold);font-size:13px;font-weight:700;cursor:pointer;padding:0 0 14px;display:block;}
  .grid-options { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
  .option-box { background: var(--surface); border: 2px solid var(--line); border-radius: 8px; padding: 16px; text-align: center; cursor: pointer; font-weight: 600; }
  .option-box.selected { border-color: var(--gold); background: rgba(242,194,48,0.1); }
  .switchrole{text-align:center;margin-top:20px;}
  .switchrole a{color:var(--grey);font-size:12px;text-decoration:underline;cursor:pointer;}
  .photo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 16px; }
  .photo-card { background: var(--surface); border-radius: 6px; overflow: hidden; border: 1px solid var(--line); }
  .photo-card img { width: 100%; height: 120px; object-fit: cover; display: block; }
  .photo-card p { padding: 8px; margin: 0; font-size: 12px; text-align: center; }
</style>
</head>
<body>

<div id="app">
  <div class="brandbar">
    <div style="padding: 10px; font-weight: bold; color: var(--gold); font-size: 24px; letter-spacing: 2px;">
        ZAGO AUTO SERVICE
    </div>
  </div>

  <!-- SCREEN 1: HOME INICIAL -->
  <div id="screen-home" class="screen">
    <h2 class="title">Bem-vindo</h2>
    <p class="sub">Agende seu serviço ou peça um orçamento em poucos toques.</p>
    
    <button class="bigbtn" onclick="go('screen-auth-cliente')">
      <div class="ic">C</div>
      <div>
        <div>Sou cliente</div>
        <div class="meta">Agendar, pedir orçamento, ver status</div>
      </div>
    </button>

    <h3 style="margin-top: 24px; color: var(--gold); font-size: 15px; font-weight: bold;">NOSSOS TRABALHOS</h3>
    <div id="home-galeria" class="photo-grid"></div>

    <h3 style="margin-top: 24px; color: var(--gold); font-size: 15px; font-weight: bold;">O QUE DIZEM NOSSOS CLIENTES</h3>
    <div id="home-avaliacoes" style="margin-top:10px;"></div>

    <div class="switchrole">
      <a onclick="go('screen-auth-equipe')">Acesso da equipe</a>
    </div>
  </div>

  <!-- SCREEN 2: AUTH CLIENTE -->
  <div id="screen-auth-cliente" class="screen hide">
    <button class="wizback" onclick="go('screen-home')">‹ Voltar</button>
    <h2 class="title">Entrar como cliente</h2>
    <p class="sub">Acesse ou crie sua conta com seu número de WhatsApp.</p>
    <button class="btn" onclick="go('screen-cadastro-cliente')">Criar conta</button>
    <button class="btn secondary" onclick="go('screen-login-cliente')">Já tenho conta</button>
  </div>

  <!-- SCREEN 3: CADASTRO CLIENTE -->
  <div id="screen-cadastro-cliente" class="screen hide">
    <button class="wizback" onclick="go('screen-auth-cliente')">‹ Voltar</button>
    <h2 class="title">Criar conta</h2>
    
    <label>Nome completo</label>
    <input type="text" id="cad-nome" placeholder="Ex: João Silva">
    
    <label>WhatsApp (com DDD)</label>
    <input type="tel" id="cad-fone" placeholder="Ex: 14999999999">
    
    <label>Crie uma senha</label>
    <input type="password" id="cad-senha" placeholder="Mínimo 6 dígitos">

    <div style="background: var(--surface); padding: 12px; border-radius: 6px; margin: 12px 0; border: 1px solid var(--line);">
        <p style="font-size: 11px; color: var(--grey); margin: 0;">Usamos seus dados estritamente para o gerenciamento de serviços na oficina conforme as diretrizes da LGPD.</p>
    </div>

    <button class="btn" onclick="execCadastro()">Criar conta e entrar</button>
  </div>

  <!-- SCREEN 4: LOGIN CLIENTE -->
  <div id="screen-login-cliente" class="screen hide">
    <button class="wizback" onclick="go('screen-auth-cliente')">‹ Voltar</button>
    <h2 class="title">Acesse sua conta</h2>
    
    <label>WhatsApp (com DDD)</label>
    <input type="tel" id="login-fone" placeholder="Ex: 14999999999">

    <label>Sua senha</label>
    <input type="password" id="login-senha" placeholder="Digite sua senha">

    <button class="btn" onclick="execLoginCliente()">Entrar</button>
  </div>

  <!-- SCREEN 5: DASHBOARD DO CLIENTE -->
  <div id="screen-dash-cliente" class="screen hide">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 id="client-welcome-name" class="title">Olá!</h2>
        <a onclick="logoutCliente()" style="color: var(--gold); font-size: 13px; font-weight: bold; cursor: pointer;">Sair</a>
    </div>

    <div class="grid-options">
        <div class="option-box" onclick="go('screen-agendar-1')">📅<br><span style="font-size:13px;">Agendar</span></div>
        <div class="option-box" onclick="go('screen-pedir-orcamento-1')">📝<br><span style="font-size:13px;">Orçamento</span></div>
        <div class="option-box" onclick="abrirMeusPedidos()">🔍<br><span style="font-size:13px;">Status</span></div>
        <div class="option-box" onclick="abrirMeusVeiculos()">🚗<br><span style="font-size:13px;">Veículos</span></div>
    </div>

    <div class="option-box" style="margin-bottom: 12px; text-align: left;" onclick="abrirMeusCupons()">
        🎟️ <strong>Meus cupons de desconto</strong>
    </div>

    <div style="text-align: center; margin-top: 30px;">
        <a onclick="solicitarExclusaoDados()" style="color: #555; font-size: 11px; cursor:pointer;">Solicitar exclusão de dados (LGPD)</a>
    </div>
  </div>

  <!-- SCREEN: MEUS CUPONS -->
  <div id="screen-meus-cupons" class="screen hide">
    <button class="wizback" onclick="go('screen-dash-cliente')">‹ Voltar</button>
    <h2 class="title">Meus cupons</h2>
    <div id="lista-cupons-cliente"></div>
  </div>

  <!-- SCREEN: MEUS VEÍCULOS -->
  <div id="screen-meus-veiculos" class="screen hide">
    <button class="wizback" onclick="go('screen-dash-cliente')">‹ Voltar</button>
    <h2 class="title">Meus veículos</h2>
    <div id="lista-veiculos-cliente" style="margin-bottom:20px;"></div>
    
    <h3 style="border-top:1px solid var(--line); padding-top:16px; font-size:15px; margin-bottom:10px;">Adicionar veículo</h3>
    <label>Modelo</label><input type="text" id="add-car-modelo" placeholder="Ex: Civic 2.0">
    <label>Ano</label><input type="number" id="add-car-ano" placeholder="Ex: 2018">
    <label>Placa</label><input type="text" id="add-car-placa" placeholder="Ex: ABC1D23">
    <button class="btn" onclick="execAddVeiculo()">Adicionar carro</button>
  </div>

  <!-- SCREEN: AGENDAMENTO STEP 1 -->
  <div id="screen-agendar-1" class="screen hide">
    <button class="wizback" onclick="go('screen-dash-cliente')">‹ Voltar</button>
    <h2 class="title">O que você precisa hoje?</h2>
    <div class="grid-options">
        <div class="option-box opt-serv" onclick="selectOpt(this, 'Elétrica')">Elétrica</div>
        <div class="option-box opt-serv" onclick="selectOpt(this, 'Mecânica')">Mecânica</div>
        <div class="option-box opt-serv" onclick="selectOpt(this, 'Revisão')">Revisão</div>
